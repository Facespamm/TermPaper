@using System.Net
@using TermPaper.Application.Common
@using Microsoft.AspNetCore.Components.Authorization
@using TermPaper.Components.Dialogs
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject DialogService DialogService

<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
    
    <div class="container-fluid">

        <a class="navbar-brand" href="/home">
            <img src="/images/Logo.png"
                 alt="Logo"
                 width="160"
                 height="50"
                 class="d-inline-block align-middle">
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/home">
                        Home
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="/ProfilePage">
                        Profile
                    </a>
                </li>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <li class="nav-item">
                            <a class="nav-link" href="/AdminPanel">
                                Admin
                            </a>
                        </li>
                    </Authorized>
                </AuthorizeView>

            </ul>

            <form class="d-flex align-items-center" role="search">
                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-outline-secondary btn-sm me-2"
                                type="button"
                                title="Help: create a support ticket"
                                aria-label="Help"
                                @onclick="OpenSupportTicket">
                            <i class="bi bi-question-circle"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>

                <input class="form-control form-control-sm me-2"
                       type="search"
                       placeholder="Search"
                       aria-label="Search"/>

                <button class="btn btn-outline-success btn-sm me-2"
                        type="submit">
                    Search
                </button>
                <button class="btn btn-primary btn-sm"
                        type="button" @onclick="LogOutClick">
                    logOut
                </button>
            </form>
        </div>

    </div>
</nav>

<div class="page">
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>

    <AuthorizeView>
        <Authorized>
            <footer class="border-top bg-body-tertiary py-2 text-center small">
                <a href="#" class="text-decoration-none"
                   @onclick="OpenSupportTicket" @onclick:preventDefault>
                    Create support ticket
                </a>
            </footer>
        </Authorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

@code
{
    private async Task LogOutClick()
    {
        Navigation.NavigateTo("api/auth/log-out",forceLoad: true);
    }
    private async Task OpenSupportTicket()
    {
        var parameters = new Dictionary<string, object>
        {
            ["Link"] = Navigation.Uri
        };
        var positionId = GetCurrentPositionId();
        if (positionId != null)
            parameters["PositionId"] = positionId.Value;

        await DialogService.OpenAsync<SupportTicketDialog>(
            "Create support ticket",
            parameters,
            new DialogOptions { Width = "520px", Height = "auto" });
    }
    private int? GetCurrentPositionId()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
        var parts = path.Split('/');
        return parts.Length == 2
               && parts[0].Equals("positions", StringComparison.OrdinalIgnoreCase)
               && int.TryParse(parts[1], out var id)
            ? id
            : null;
    }
}
