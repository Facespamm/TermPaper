@page "/ProfileInfoSection"
@using TermPaper.Application.Interface
@using TermPaper.Application.Dto.UsersAttributesDto
@using TermPaper.Application.Dto
@using TermPaper.Enum
@inject IAttributeService AttributeService
@inject DialogService DialogService
@implements IDisposable

<RadzenStack Gap="1rem">

    @foreach (var item in userValues)
    {
        <RadzenFormField Text="@(item.Attribute.Name)" Variant="Variant.Outlined">
            @switch (item.Attribute.DataType)
            {
                case DataType.String:
                    <RadzenTextBox TValue="string"
                                   Value="@item.Value"
                                   ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;

                case DataType.Text:
                    <RadzenTextArea Value="@item.Value"
                                    Rows="4"
                                    ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;

                case DataType.Numeric:
                    <RadzenNumeric TValue="decimal?"
                                   Value="@ParseDecimal(item.Value)"
                                   ValueChanged="@(v => OnValueChanged(item, v?.ToString() ?? ""))" />
                    break;

                case DataType.Date:
                    <RadzenDatePicker TValue="DateTime?"
                                      Value="@ParseDate(item.Value)"
                                      ValueChanged="@(v => OnValueChanged(item, v?.ToString("O") ?? ""))" />
                    break;

                case DataType.Boolean:
                    <RadzenCheckBox TValue="bool"
                                    Value="@(item.Value == "true")"
                                    ValueChanged="@(v => OnValueChanged(item, v.ToString().ToLower()))" />
                    break;

                case DataType.Dropdown:
                    <RadzenDropDown TValue="string"
                                    Data="@(item.Attribute.AttributeValueOptions.Select(x => x.Value).ToList())"
                                    Value="@item.Value"
                                    ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;

                default:
                    <RadzenTextBox TValue="string"
                                   Value="@item.Value"
                                   ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;
            }
        </RadzenFormField>
    }

</RadzenStack>

<RadzenButton Text="Добавить атрибут"
              Icon="add"
              Click="@OpenAddAttributeDialog"
              class="rz-mt-4" />

@code {
    [Parameter] public string UserId { get; set; } = "";

    private List<GetUserAttributeDto> userValues = new();

    private Dictionary<int, string> pendingChanges = new();
    private System.Threading.Timer? autoSaveTimer;

    protected override async Task OnInitializedAsync()
    {
        userValues = await AttributeService.GetUserAttributeValuesAsync(UserId);

        autoSaveTimer = new System.Threading.Timer(
            async _ => await AutoSaveAsync(),
            null,
            TimeSpan.FromSeconds(7),
            TimeSpan.FromSeconds(7));
    }

    private void OnValueChanged(GetUserAttributeDto item, string newValue)
    {
        item.Value = newValue;
        pendingChanges[item.Id] = newValue;
    }

    private async Task AutoSaveAsync()
    {
        if (pendingChanges.Count == 0)
            return;

        var changesToSave = new Dictionary<int, string>(pendingChanges);
        pendingChanges.Clear();

        foreach (var (id, value) in changesToSave)
        {
            var item = userValues.FirstOrDefault(x => x.Id == id);

            if (item == null)
                continue;

            var dto = new UpdateUserAttributeDto
            {
                Id = item.Id,
                Value = value,
                Version = item.Version
            };

            var result = await AttributeService.UpdateUserAttribute(dto);

            if (!result.IsSuccess &&
                result.ErrorCode == ErrorCode.ConcurrencyConflict)
            {
                userValues = await AttributeService.GetUserAttributeValuesAsync(UserId);
            }
        }

        userValues = await AttributeService.GetUserAttributeValuesAsync(UserId);

        await InvokeAsync(StateHasChanged);
    }

    private decimal? ParseDecimal(string? value)
    {
        return decimal.TryParse(value, out var result)
            ? result
            : null;
    }

    private DateTime? ParseDate(string? value)
    {
        return DateTime.TryParse(value, out var result)
            ? result
            : null;
    }

    private async Task OpenAddAttributeDialog()
    {
        var result = await DialogService.OpenAsync<AddAttributeDialog>(
            "Добавить атрибут",
            new Dictionary<string, object> { { "UserId", UserId } },
            new DialogOptions { Width = "450px", Height = "auto" }
        );

        if (result is true) // юзер реально что-то выбрал и добавил
        {
            userValues = await AttributeService.GetUserAttributeValuesAsync(UserId); // обновляем список
        }
    }
    public void Dispose()
    {
        autoSaveTimer?.Dispose();
    }
}
