@page "/AdminPanel"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="adminPanel-page">

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-2">
        <RadzenButton Text="Block" Icon="block" ButtonStyle="ButtonStyle.Danger" />
        <RadzenButton Text="Unlock" Icon="check_circle" ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Text="Assign role: Recruiter" />
        <RadzenButton Text="Assign role: Candidate" />
        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" />
    </RadzenStack>

    <RadzenDataGrid AllowFiltering="true"
                    AllowColumnResize="true"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    FilterMode="FilterMode.Advanced"
                    Data=""
                    ColumnWidth="200px"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    >
        <Columns>
            <RadzenDataGridColumn Property="Email" Title="Email" Width="260px" />
            <RadzenDataGridColumn Property="UserName" Title="User name" Width="200px" />
            <RadzenDataGridColumn Property="Roles" Title="Роль" Width="180px" />
            <RadzenDataGridColumn Property="EmailConfirmed" Title="Email confirmed" Width="150px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="IsLockedOut" Title="Is Locked" Width="130px" TextAlign="TextAlign.Center" />
        </Columns>
    </RadzenDataGrid>
</div>
<h3>AdminPannel</h3>

