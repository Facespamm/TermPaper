@page "/AdminPanel"

@using Microsoft.AspNetCore.Authorization
@using TermPaper.Application.Dto
@using TermPaper.Application.Interface

@attribute [Authorize(Roles = "Admin")]

@inject IUserManagementService userManegement

<div class="adminPanel-page">
   
    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="0.5rem"
                 class="rz-mb-2"
                 JustifyContent="JustifyContent.Center">

        <RadzenButton Text="Block"
                      Icon="block"
                      ButtonStyle="ButtonStyle.Danger"/>

        <RadzenButton Text="Unlock"
                      Icon="check_circle"
                      ButtonStyle="ButtonStyle.Success"/>

        <RadzenButton Text="Assign role: Recruiter"/>

        <RadzenButton Text="Assign role: Candidate"/>

        <RadzenButton Text="Delete"
                      Icon="delete"
                      ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Outlined"/>

    </RadzenStack>

    <RadzenDataGrid AllowFiltering="true"
                    AllowColumnResize="true"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    AllowRowSelectOnRowClick="true"
                    FilterMode="FilterMode.Advanced"
                    @bind-Value="@selectedUsers"
                    TItem="UserDto"
                    Data="@users"
                    ColumnWidth="200px"
                    SelectionMode="DataGridSelectionMode.Multiple">

        <Columns>

            <RadzenDataGridColumn Property="Email"
                                  Title="Email"
                                  Width="260px" />

            <RadzenDataGridColumn Property="UserName"
                                  Title="User name"
                                  Width="200px" />

            <RadzenDataGridColumn TItem="UserDto"
                                  Property="Roles"
                                  Title="Roles"
                                  Width="180px">

                <Template Context="data">
                    @string.Join(", ", data.Roles)
                </Template>

            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="EmailConfirmed"
                                  Title="Email confirmed"
                                  Width="150px"
                                  TextAlign="TextAlign.Center" />

            <RadzenDataGridColumn Property="IsLockedOut"
                                  Title="Is Locked"
                                  Width="130px"
                                  TextAlign="TextAlign.Center" />

        </Columns>

    </RadzenDataGrid>

</div>

@code {
    private IList<UserDto> users = new List<UserDto>();
    private IList<UserDto> selectedUsers = new List<UserDto>();

    protected override async Task OnInitializedAsync()
    {
        users = await userManegement.GetUsersAsync();
    }
}