@page "/ProfileMeSection"
@using TermPaper.Application.Interface
@using TermPaper.Application.Dto.UsersAttributesDto
@using TermPaper.Enum
@inject IAttributeService AttributeService
@implements IDisposable

<RadzenStack Gap="1rem">

    @foreach (var item in meValues)
    {
        <RadzenFormField Text="@(item.Attribute.Name)" Variant="Variant.Outlined">
            @switch (item.Attribute.DataType)
            {
                case DataType.String:
                    <RadzenTextBox TValue="string"
                                   Value="@item.Value"
                                   ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;

                case DataType.Text:
                    <RadzenTextArea Value="@item.Value"
                                    Rows="4"
                                    ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;

                case DataType.Date:
                    <RadzenDatePicker TValue="DateTime?"
                                      Value="@ParseDate(item.Value)"
                                      ValueChanged="@(v => OnValueChanged(item, v?.ToString("O") ?? ""))" />
                    break;

                case DataType.Image:
                    <div class="rz-p-2">
                        @if (!string.IsNullOrWhiteSpace(item.Value))
                        {
                            <img src="@item.Value" style="max-width:150px;border-radius:8px;" />
                        }
                        <p class="rz-text-caption">Загрузка через Cloudinary — подключим отдельно</p>
                    </div>
                    break;

                default:
                    <RadzenTextBox TValue="string"
                                   Value="@item.Value"
                                   ValueChanged="@(v => OnValueChanged(item, v ?? ""))" />
                    break;
            }
        </RadzenFormField>
    }

    @if (savingIndicatorVisible)
    {
        <RadzenText TextStyle="TextStyle.Caption">Сохранение...</RadzenText>
    }

</RadzenStack>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private List<GetUserAttributeDto> meValues = new();

    private Dictionary<int, string> pendingChanges = new();   
    private System.Threading.Timer? autoSaveTimer;
    private bool savingIndicatorVisible;

    protected override async Task OnInitializedAsync()
    {
        meValues = await AttributeService.GetUserBuiltInAttributeValuesAsync(UserId);

        autoSaveTimer = new System.Threading.Timer(
            async _ => await AutoSaveAsync(),
            null,
            TimeSpan.FromSeconds(7),
            TimeSpan.FromSeconds(7));
    }

    private void OnValueChanged(GetUserAttributeDto item, string newValue)
    {
        item.Value = newValue;
        pendingChanges[item.AttributeId] = newValue;   
    }

    private async Task AutoSaveAsync()
    {
        if (pendingChanges.Count == 0)
            return;

        savingIndicatorVisible = true;
        await InvokeAsync(StateHasChanged);

        var changesToSave = new Dictionary<int, string>(pendingChanges);
        pendingChanges.Clear();

        foreach (var (attributeId, value) in changesToSave)
        {
            var item = meValues.FirstOrDefault(x => x.AttributeId == attributeId);
            if (item == null) continue;

            if (item.Id == 0)
            {
                await AttributeService.AddToUsersValue(new UserAttributesAddDto
                {
                    AttributeId = attributeId,
                    UserId = UserId,
                    Value = value
                });
            }
            else
            {
                await AttributeService.UpdateUserAttribute(new UpdateUserAttributeDto
                {
                    Id = item.Id,
                    Value = value,
                    Version = item.Version
                });
            }
        }

        meValues = await AttributeService.GetUserBuiltInAttributeValuesAsync(UserId);

        savingIndicatorVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private DateTime? ParseDate(string? value) =>
        DateTime.TryParse(value, out var result) ? result : null;

    public void Dispose()
    {
        autoSaveTimer?.Dispose();
    }
}
}