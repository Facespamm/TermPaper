@page "/RegisterPage"
@using Microsoft.AspNetCore.Identity
@layout EmptyLayout

@using TermPaper.Application.Interface
@inject IRegisterService RegisterService
@rendermode InteractiveServer
<div class="Register-page">
    <div class="register-form">
        <form>
            @if (!string.IsNullOrWhiteSpace(result))
            {
                @if (isSuccess)
                {
                    <div class="alert alert-success" role="alert">
                        @result
                    </div>
                }
                else
                {
                    <div class="alert alert-danger" role="alert">
                        @result
                    </div>
                }
            }
            <i class="bi bi-briefcase"></i>
            <h3>Register form</h3>
            <div class="mb-3">
                <label for="exampleUserName">User name</label>
                <input @bind="userName" class="form-control" id="exampleUserName" placeholder="User name" required/>
            </div>
            <div class="mb-3">
                <label for="exampleEmail">Email</label>
                <input @bind="email" class="form-control" id="exampleEmail" placeholder="Email" required/>
            </div>
            <div class="mb-3">
                <label for="examplePassword">Password</label>
                <div class="input-group">
                    <input type="@(showPassword ? "text" : "password")" @bind="password" class="form-control" id="examplePassword" placeholder="Password" required/>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleShowPassword">
                        @if (!showPassword)
                        {
                            <i class="bi bi-eye-slash"></i>
                        }
                        else
                        {
                            <i class="bi bi-eye"></i>
                        }
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label for="exampleCheckPassword">Check password</label>
                <div class="input-group">
                    <input type="@(showPassword ? "text" : "password")" @bind="checkPassword" class="form-control" id="exampleCheckPassword" placeholder="Check Password" required/>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleShowPassword">
                        @if (!showPassword)
                        {
                            <i class="bi bi-eye-slash"></i>
                        }
                        else
                        {
                            <i class="bi bi-eye"></i>
                        }
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="HandleClick" class="btn btn-primary w-100 align-content-center">Register</button>
            </div>
            <p><a href="/LoginPage">Do you have a account?</a></p>
        </form>
    </div>
    <div class="register-img"></div>
</div>
@code {
    private string userName = "";
    private string password = "";
    private string email = "";
    private string checkPassword = "";
    private string result = "";
    private bool showPassword = false;
    private bool isSuccess = false;

    private async Task HandleClick()
    {
        var reg = await RegisterService.RegisterUserAsync(email, password, checkPassword, userName);
        if (!reg.IsSuccess)
        {
            result = !string.IsNullOrWhiteSpace(reg.ErrorMessage) ? reg.ErrorMessage : $"Registration failed: {reg.ErrorCode}";
            return;
        }
        result = "A confirmation email has been sent to your email address.";
        isSuccess = true;
    }

    private void ToggleShowPassword()
    {
        showPassword = !showPassword;
    }
}