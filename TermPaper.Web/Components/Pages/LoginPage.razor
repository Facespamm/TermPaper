@page "/"
@page "/LoginPage"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using TermPaper.Application.Interface
@inject ILoginService LoginService
@inject NavigationManager Navigation
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@using TermPaper.Application.Common
@using Microsoft.AspNetCore.WebUtilities
<div class="login-page">
    <div class="login-form">    
        <form method="post" action="/api/auth/login">
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
                    <div>
                        @error
                    </div>
                </div>
            }            <div class="mb-3">
                <i class="bi bi-briefcase"></i>
                <label for="exampleEmail" class="form-label">Login</label>
                <input name="email" @bind="email" class="form-control" id="exampleEmail" placeholder="Email" required=""/>
            </div>

            <div class="mb-3">
                <label for="examplePassword" class="form-la">Password</label>
                <div class="input-group">
                    <input type="@(showPassword ? "text" : "password")" name="password" @bind="password" class="form-control" id="examplePassword" placeholder="Password" required/>
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        @if (!showPassword)
                        {
                            <i class="bi bi-eye-slash"></i>
                        }
                        else
                        {
                            <i class="bi bi-eye"></i>
                        }
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary w-100 align-content-center">Login</button>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="GoogleLoginClick" class="btn btn-primary w-100 align-content-center">
                    <i class="bi bi-google"></i>
                </button>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="FacebookLoginClick" class="btn btn-primary w-100 align-content-center">
                    <i class="bi bi-facebook"></i>
                </button>
            </div>
            <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMe">
            <label class="form-check-label" for="rememberMe">Remember me</label>
            <p><a href="/RegisterPage" class="ms-2">Don't have an account?</a></p>
        </form>
    </div>
</div>  
@code {
    private string email = "";
    private string password = "";
    private string error = "";
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = errorCode.ToString() switch
            {
                "UserNotFound" => "User with this email was not found.",
                "PasswordsDoNotMatch" => "Incorrect password.",
                _ => "An error occurred while signing in. Please try again."
            };        }
    }
    private void GoogleLoginClick()
    {
        Navigation.NavigateTo("/api/auth/google-login", forceLoad: true);
    }
    private void FacebookLoginClick()
    {
        Navigation.NavigateTo("/api/auth/facebook-login", forceLoad: true);
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
}