@page "/LoginPage"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using TermPaper.Application.Interface
@inject ILoginService LoginService
@inject NavigationManager Navigation
@using TermPaper.Application
@using TermPaper.Application.Common
<div class="login-page">
    <div class="login-form">    
        <form>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
                    <div>
                        @error
                    </div>
                </div>
            }            <div class="mb-3">
                <i class="bi bi-briefcase"></i>
                <label for="exampleEmail" class="form-label">Login</label>
                <input @bind="email" class="form-control" id="exampleEmail" placeholder="Email" required=""/>
            </div>

            <div class="mb-3">
                <label for="examplePassword" class="form-la">Password</label>
                <div class="input-group">
                    <input type="@(showPassword ? "text" : "password")" @bind="password" class="form-control" id="examplePassword" placeholder="Password" required/>
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        @if (!showPassword)
                        {
                            <i class="bi bi-eye-slash"></i>
                        }
                        else
                        {
                            <i class="bi bi-eye"></i>
                        }
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="HandleClick" class="btn btn-primary w-100 align-content-center">Login</button>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="GoogleLoginClick" class="btn btn-primary w-100 align-content-center">
                    <i class="bi bi-google"></i>
                </button>
            </div>
            <div class="mb-3">
                <button type="button" @onclick="FacebookLoginClick" class="btn btn-primary w-100 align-content-center">
                    <i class="bi bi-facebook"></i>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            <input class="form-check-input" type="checkbox" id="rememberMe">
            <label class="form-check-label" for="rememberMe">Remember me</label>
            <p><a href="/RegisterPage" class="ms-2">Don't have an account?</a></p>
        </form>
    </div>
</div>  
@code {
    private string email = "";
    private string password = "";
    private string error = "";
    private bool showPassword = false;

    private async Task HandleClick()
    {
        var login = await LoginService.LoginUsersAsync(email, password);
        if (login.IsSuccess){Navigation.NavigateTo("/");return;}
        error = "Failed to login";
    }

    private async Task GoogleLoginClick()
    {
        Navigation.NavigateTo("/api/auth/google-login");
    }
    private async Task FacebookLoginClick()
    {
        Navigation.NavigateTo("/api/auth/facebook-login");
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
}