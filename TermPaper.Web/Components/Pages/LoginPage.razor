@page "/LoginPage"
@using Microsoft.AspNetCore.Identity
@using TermPaper.Services
@inject AutorisationsServices Autorisations
@inject NavigationManager Navigation
<div class="login-page">
    <div class="login-form">
        <form>
            <h3>Login form</h3>
            <label for="exampleLogin">Login</label>
            <input @bind="email" class="form-control" id="exampleEmail" placeholder="Email" required=""/>
            <label for="examplePassword">Password</label>
            <input type="password" @bind="password" class="form-control" id="examplePassword" placeholder="Password" required/>
            <button type="button" @onclick="HandleClick" class="btn btn-primary w-100 align-content-center">Login</button>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            <p>Don't have an account?<a href="/RegisterPage" class="ms-2"></a></p>
        </form>
    </div>
    <div class="login-img"></div>   
</div>
@code {
    private string email = "";
    private string password = "";
    private string error = "";

    private async Task HandleClick()
    {
   //    var login = await Autorisations.LoginUsersAsync(email, password);
   //    if (login.Succeeded){Navigation.NavigateTo("/");return;}
       error = "Failed to login";
       
        
    }
}