@using TermPaper.Application.Interface
@using TermPaper.Application.Dto
@using TermPaper.Enum
@inject IAttributeService AttributeService
@inject DialogService DialogService

<RadzenStack Gap="1rem" class="rz-p-4" style="min-width: 350px;">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@errorMessage</RadzenAlert>
    }

    <RadzenFormField Text="Name">
        <RadzenTextBox @bind-Value="@name" />
    </RadzenFormField>

    <RadzenFormField Text="Category">
        <RadzenDropDown Data="@categories" TextProperty="Name" ValueProperty="Id"
                        @bind-Value="@categoryId" />
    </RadzenFormField>

    @if (!showNewCategoryInput)
    {
        <RadzenButton Text="+ New category" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@(() => showNewCategoryInput = true)" />
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <RadzenTextBox @bind-Value="@newCategoryName" Placeholder="New category name" />
            <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@AddCategory" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@CancelNewCategory" />
        </RadzenStack>
    }

    <RadzenFormField Text="Data Type">
        <RadzenDropDown Data="@dataTypes" @bind-Value="@dataType"
                        Disabled="@isEdit" />
    </RadzenFormField>

    <RadzenFormField Text="Description">
        <RadzenTextArea @bind-Value="@description" Rows="3" />
    </RadzenFormField>

    <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
</RadzenStack>

@code {
    [Parameter] public AttributeGetDto? Existing { get; set; }

    private bool isEdit => Existing != null;

    private List<AttributeGetCategoryDto> categories = new();
    private DataType[] dataTypes = Enum.GetValues<DataType>();
    private string name = "";
    private int categoryId;
    private DataType dataType = DataType.String;
    private string description = "";
    private uint version;
    private string? errorMessage;
    private bool showNewCategoryInput;
    private string newCategoryName = "";

    private void CancelNewCategory()
    {
        showNewCategoryInput = false;
        newCategoryName = "";
    }

    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName)) return;

        var result = await AttributeService.CreateCategory(new AttributeCreateCategoryDto { Name = newCategoryName });
        if (result.IsSuccess)
        {
            categories = await AttributeService.GetCategory();
            var created = categories.FirstOrDefault(c => c.Name == newCategoryName);
            if (created != null) categoryId = created.Id;
            newCategoryName = "";
            showNewCategoryInput = false;
        }
        else
        {
            errorMessage = "Failed to create category.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        categories = await AttributeService.GetCategory();

        if (Existing != null)
        {
            name = Existing.Name;
            categoryId = Existing.CategoryId;
            dataType = Existing.DataType;
            description = Existing.Description;
            version = Existing.Version;
        }
    }

    private async Task Save()
    {
        var result = isEdit
            ? await AttributeService.UpdateAttribute(new UpdateAttributeDto
            {
                Id = Existing!.Id,
                Name = name,
                CategoryId = categoryId,
                Description = description,
                Version = version
            })
            : await AttributeService.CreateAttribute(new CreateAttributeDto
            {
                Name = name,
                CategoryId = categoryId,
                DataType = dataType,
                Description = description
            });

        if (result.IsSuccess)
        {
            DialogService.Close(true);
        }
        else if (result.ErrorCode == ErrorCode.ConcurrencyConflict)
        {
            errorMessage = "The attribute has already been modified by someone else. Close the window and open it again.";
        }
        else
        {
            errorMessage = "Failed to save.";
        }
    }
}